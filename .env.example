# ==============================================================================
# AETHERGUARD AI - SUPABASE CLOUD DATABASE CONFIGURATION
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
# Example: https://xyzcompany.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key or Service Role Key
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Optional Direct PostgreSQL Connection URI (if using SQLAlchemy or Prisma)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# Server Host & Port
PORT=8000
HOST=127.0.0.1
